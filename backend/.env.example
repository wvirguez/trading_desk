# Copia este archivo a .env y ajusta los valores.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://quant_admin:quant_secret_dev@localhost:5432/quant_terminal_db
TEST_DATABASE_URL=postgresql+asyncpg://quant_admin:quant_secret_dev@localhost:5432/quant_terminal_test
DB_CONNECT_TIMEOUT_S=3

# OANDA (cuenta practice). Déjalos vacíos si aún no tienes cuenta.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Horizontes de backfill por defecto
BACKFILL_DAYS_5M=90
BACKFILL_DAYS_15M=365
BACKFILL_YEARS_1H=5
BACKFILL_YEARS_4H=5
BACKFILL_YEARS_1D=5

# Horizontes de Yahoo (provisional): son los límites del proveedor; subirlos no da más historia.
BACKFILL_DAYS_5M_YAHOO=59
BACKFILL_DAYS_15M_YAHOO=59
BACKFILL_DAYS_1H_YAHOO=729
BACKFILL_DAYS_4H_YAHOO=729

# Riesgo y motor cuantitativo (porcentajes en unidades de %: 1.0 = 1 %)
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MIN_RR=1.8
KELLY_FRACTION=0.25
MAX_OPEN_RISK_PCT=3.0
MAX_CORRELATED_RISK_PCT=2.0
CORRELATION_WINDOW=100
CORRELATION_THRESHOLD=0.7
BACKTEST_MAX_BARS=50000

# Agentes (Fase 3). Sin la clave del proveedor activo los agentes quedan deshabilitados (503).
# AGENT_PROVIDER: anthropic (por defecto) | google (Gemini).
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Con AGENT_PROVIDER=google, AGENT_MODEL es obligatorio y debe ser un modelo Gemini
# (el valor por defecto claude-sonnet-5-5 solo vale para anthropic).
AGENT_MODEL=claude-sonnet-5-5
AGENT_AUDITOR_MODEL=
# Tiempo máximo por ejecución de agente: limita la ejecución completa (todas sus llamadas), no cada llamada.
AGENT_TIMEOUT_S=120
AGENT_MAX_TOKENS_PER_ANALYSIS=60000
# El tope de coste exige definir también los dos precios (USD por millón de tokens).
AGENT_MAX_COST_USD_PER_ANALYSIS=
AGENT_PRICE_INPUT_USD_PER_MTOK=
AGENT_PRICE_OUTPUT_USD_PER_MTOK=
ACCOUNT_EQUITY_USD=10000
ANALYSIS_LOOKBACK_BARS=500
PROPOSAL_TARGET_RR=2.0
PROPOSAL_SL_ATR_BUFFER=0.5
