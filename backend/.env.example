# Copia este archivo a .env y ajusta los valores.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://quant_admin:quant_secret_dev@localhost:5432/quant_terminal_db
TEST_DATABASE_URL=postgresql+asyncpg://quant_admin:quant_secret_dev@localhost:5432/quant_terminal_test
DB_CONNECT_TIMEOUT_S=3

# OANDA (cuenta practice). Déjalos vacíos si aún no tienes cuenta.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Horizontes de backfill por defecto
BACKFILL_DAYS_15M=365
BACKFILL_YEARS_1H=5
BACKFILL_YEARS_4H=5
BACKFILL_YEARS_1D=5
