          "timeframes": {
            "items": {
              "$ref": "#/components/schemas/Timeframe"
            },
            "title": "Timeframes",
            "type": "array"
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "symbol",
          "timeframe",
          "timeframes",
          "started_at"
        ],
        "title": "AnalysisStarted",
        "type": "object"
      },
      "AnalysisStep": {
        "enum": [
