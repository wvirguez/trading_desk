            "type": "integer"
          },
          "step": {
            "$ref": "#/components/schemas/AnalysisStep"
          },
          "usage": {
            "$ref": "#/components/schemas/StepUsage"
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "step",
          "output",
          "usage"
        ],
        "title": "StepCompleted",
        "type": "object"
      },
      "StepFailed": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "event": {
            "const": "step_failed",
            "default": "step_failed",
            "title": "Event",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "step": {
            "$ref": "#/components/schemas/AnalysisStep"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StepUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "step",
          "error"
        ],
        "title": "StepFailed",
        "type": "object"
      },
      "StepStarted": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "event": {
            "const": "step_started",
            "default": "step_started",
            "title": "Event",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "step": {
            "$ref": "#/components/schemas/AnalysisStep"
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "step"
        ],
        "title": "StepStarted",
        "type": "object"
      },
      "StepUsage": {
        "additionalProperties": false,
        "properties": {
          "cost_usd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "input_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Output Tokens",
            "type": "integer"
          }
        },
        "title": "StepUsage",
        "type": "object"
      },
      "StructureEventType": {
        "enum": [
          "BOS",
          "CHOCH"
        ],
        "title": "StructureEventType",
        "type": "string"
      },
      "Timeframe": {
        "enum": [
          "5m",
          "15m",
          "1h",
          "4h",
          "1d"
        ],
        "title": "Timeframe",
        "type": "string"
      },
      "TimeframeStructure": {
        "additionalProperties": false,
        "properties": {
          "bias": {
            "$ref": "#/components/schemas/Bias"
          },
          "comment": {
            "maxLength": 1500,
            "title": "Comment",
            "type": "string"
          },
          "key_levels": {
            "items": {
              "type": "string"
            },
            "title": "Key Levels",
            "type": "array"
          },
          "last_event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StructureEventType"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_fvg_ts": {
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "title": "Open Fvg Ts",
            "type": "array"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          }
        },
        "required": [
          "timeframe",
          "bias",
          "key_levels",
          "open_fvg_ts",
          "comment"
        ],
        "title": "TimeframeStructure",
        "type": "object"
      },
      "TradeSignalSchema": {
        "additionalProperties": false,
        "description": "Señal canónica persistida.\n\nInvariantes:\n- LONG: stop_loss < entry < take_profit; SHORT: take_profit < entry < stop_loss.\n- APPROVED: `size` presente y `veto_reasons` vacío.\n- REJECTED: `veto_reasons` no vacío (veto determinista) O, si está vacío, `rationale`\n  debe contener `AUDITOR_REJECTION_MARKER` (rechazo del auditor, que no genera\n  motivos `VetoReason`).\n- PENDING y EXECUTED no imponen reglas adicionales.",
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "asset_class": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "entry": {
            "title": "Entry",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "regime": {
            "$ref": "#/components/schemas/RegimeLabel"
          },
          "rr": {
            "title": "Rr",
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PositionSizeResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/SignalStatus"
          },
          "stop_loss": {
            "title": "Stop Loss",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "take_profit": {
            "title": "Take Profit",
            "type": "string"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          },
          "veto_reasons": {
            "items": {
              "$ref": "#/components/schemas/VetoReason"
            },
            "title": "Veto Reasons",
            "type": "array"
          }
        },
        "required": [
          "id",
          "analysis_id",
          "symbol",
          "asset_class",
          "timeframe",
          "direction",
          "entry",
          "stop_loss",
          "take_profit",
          "rr",
          "status",
          "regime",
          "rationale",
          "veto_reasons",
          "created_at"
        ],
        "title": "TradeSignalSchema",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VetoReason": {
        "enum": [
          "RR_BELOW_MIN",
          "RISK_PER_TRADE_EXCEEDED",
          "DAILY_LOSS_LIMIT",
          "OPEN_RISK_LIMIT",
          "CORRELATED_RISK_LIMIT",
          "SIZE_BELOW_LOT",
          "INVALID_LEVELS"
        ],
        "title": "VetoReason",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "QuantAgentic Terminal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agents/analyze": {
      "post": {
        "operationId": "post_analyze_api_v1_agents_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisEventEnvelope",
                  "type": "string"
                }
              }
            },
            "description": "Flujo `text/event-stream`: un evento `data: <json>` por `AnalysisEvent`. Los fallos durante el análisis llegan como `analysis_failed` (HTTP 200)."
          },
          "404": {
            "description": "Instrumento desconocido"
          },
          "422": {
            "description": "Cuerpo inválido o datos insuficientes"
          },
          "503": {
            "description": "Agentes no configurados (falta la clave del proveedor activo o AGENT_MODEL)"
          }
        },
        "summary": "Post Analyze",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/market/ohlcv": {
      "get": {
        "operationId": "get_ohlcv_api_v1_market_ohlcv_get",
        "parameters": [
          {
            "description": "Símbolo canónico, p. ej. BTC/USDT",
            "in": "query",
            "name": "symbol",
            "required": true,
            "schema": {
              "description": "Símbolo canónico, p. ej. BTC/USDT",
              "minLength": 1,
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "description": "Timeframe de las velas",
            "in": "query",
            "name": "tf",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Timeframe",
              "description": "Timeframe de las velas"
            }
          },
          {
            "description": "Número de velas",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "description": "Número de velas",
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CandleSchema"
                  },
                  "title": "Response Get Ohlcv Api V1 Market Ohlcv Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Instrumento desconocido"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ohlcv",
        "tags": [
          "market"
        ]
      }
    },
    "/api/v1/quant/backtest": {
      "post": {
        "operationId": "post_backtest_api_v1_quant_backtest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestConfig-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestMetricsSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Instrumento desconocido"
          },
          "422": {
            "description": "Configuración inválida o datos insuficientes/excesivos"
          }
        },
        "summary": "Post Backtest",
        "tags": [
          "quant"
        ]
      }
    },
    "/api/v1/signals/active": {
      "get": {
        "description": "Señales `APPROVED`, de la más reciente a la más antigua.",
        "operationId": "get_active_signals_api_v1_signals_active_get",
        "parameters": [
          {
            "description": "Filtra por clase de activo",
            "in": "query",
            "name": "asset_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AssetClass"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por clase de activo",
              "title": "Asset Class"
            }
          },
          {
            "description": "Máximo de señales",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Máximo de señales",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TradeSignalSchema"
                  },
                  "title": "Response Get Active Signals Api V1 Signals Active Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Active Signals",
        "tags": [
          "signals"
        ]
      }
    }
  }
}
