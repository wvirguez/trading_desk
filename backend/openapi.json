    "schemas": {
      "AgentReportSchema": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "guards": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GuardDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/AnalysisOutcome"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProposedSignal"
              },
              {
                "type": "null"
              }
            ]
          },
          "quant": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuantAlphaReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "risk_verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskVerdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TradeSignalSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "structure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketStructureReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          },
          "usage": {
            "$ref": "#/components/schemas/StepUsage"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "analysis_id",
          "symbol",
          "timeframe",
          "outcome",
          "usage"
        ],
        "title": "AgentReportSchema",
        "type": "object"
      },
      "AnalysisCompleted": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "event": {
            "const": "analysis_completed",
            "default": "analysis_completed",
            "title": "Event",
            "type": "string"
          },
          "report": {
            "$ref": "#/components/schemas/AgentReportSchema"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "report"
        ],
        "title": "AnalysisCompleted",
        "type": "object"
      },
      "AnalysisEventEnvelope": {
        "description": "Envoltorio nombrado de la unión discriminada, solo para publicar el tipo en OpenAPI (D108).\n\nEl protocolo SSE no cambia: cada ``data:`` sigue siendo el JSON de UN evento (no del\nenvoltorio); ``RootModel`` serializa exactamente como la unión.",
        "discriminator": {
          "mapping": {
            "analysis_completed": "#/components/schemas/AnalysisCompleted",
            "analysis_failed": "#/components/schemas/AnalysisFailed",
            "analysis_started": "#/components/schemas/AnalysisStarted",
            "step_completed": "#/components/schemas/StepCompleted",
            "step_failed": "#/components/schemas/StepFailed",
            "step_started": "#/components/schemas/StepStarted"
          },
          "propertyName": "event"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/AnalysisStarted"
          },
          {
            "$ref": "#/components/schemas/StepStarted"
          },
          {
            "$ref": "#/components/schemas/StepCompleted"
          },
          {
            "$ref": "#/components/schemas/StepFailed"
          },
          {
            "$ref": "#/components/schemas/AnalysisCompleted"
          },
          {
            "$ref": "#/components/schemas/AnalysisFailed"
          }
        ],
        "title": "AnalysisEventEnvelope"
      },
      "AnalysisFailed": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "event": {
            "const": "analysis_failed",
            "default": "analysis_failed",
            "title": "Event",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "step": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisStep"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "analysis_id",
          "seq",
          "error"
        ],
        "title": "AnalysisFailed",
        "type": "object"
      },
      "AnalysisOutcome": {
        "enum": [
          "SIGNAL_APPROVED",
          "SIGNAL_REJECTED",
          "NO_TRADE"
        ],
        "title": "AnalysisOutcome",
        "type": "string"
      },
      "AnalysisStarted": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "format": "uuid",
            "title": "Analysis Id",
            "type": "string"
