{
  "components": {
    "schemas": {
      "BacktestConfig-Input": {
        "properties": {
          "allow_short": {
            "default": true,
            "title": "Allow Short",
            "type": "boolean"
          },
          "end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "entry_z": {
            "default": 2.0,
            "title": "Entry Z",
            "type": "number"
          },
          "exit_z": {
            "default": 0.0,
            "title": "Exit Z",
            "type": "number"
          },
          "initial_capital": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "default": "10000",
            "title": "Initial Capital"
          },
          "start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          },
          "zscore_window": {
            "default": 50,
            "maximum": 500.0,
            "minimum": 10.0,
            "title": "Zscore Window",
            "type": "integer"
          }
        },
        "required": [
          "symbol",
          "timeframe"
        ],
        "title": "BacktestConfig",
        "type": "object"
      },
      "BacktestConfig-Output": {
        "properties": {
          "allow_short": {
            "default": true,
            "title": "Allow Short",
            "type": "boolean"
          },
          "end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "entry_z": {
            "default": 2.0,
            "title": "Entry Z",
            "type": "number"
          },
          "exit_z": {
            "default": 0.0,
            "title": "Exit Z",
            "type": "number"
          },
          "initial_capital": {
            "default": "10000",
            "title": "Initial Capital",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          },
          "zscore_window": {
            "default": 50,
            "maximum": 500.0,
            "minimum": 10.0,
            "title": "Zscore Window",
            "type": "integer"
          }
        },
        "required": [
          "symbol",
          "timeframe"
        ],
        "title": "BacktestConfig",
        "type": "object"
      },
      "BacktestMetricsSchema": {
        "properties": {
          "config": {
            "$ref": "#/components/schemas/BacktestConfig-Output"
          },
          "equity_curve": {
            "items": {
              "$ref": "#/components/schemas/EquityPoint"
            },
            "title": "Equity Curve",
            "type": "array"
          },
          "expectancy": {
            "title": "Expectancy",
            "type": "number"
          },
          "final_equity": {
            "title": "Final Equity",
            "type": "string"
          },
          "max_drawdown": {
            "title": "Max Drawdown",
            "type": "number"
          },
          "n_bars": {
            "title": "N Bars",
            "type": "integer"
          },
          "n_trades": {
            "title": "N Trades",
            "type": "integer"
          },
          "sharpe": {
            "title": "Sharpe",
            "type": "number"
          },
          "strategy_id": {
            "format": "uuid",
            "title": "Strategy Id",
            "type": "string"
          },
          "total_return": {
            "title": "Total Return",
            "type": "number"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "win_rate": {
            "title": "Win Rate",
            "type": "number"
          }
        },
        "required": [
          "strategy_id",
          "config",
          "n_bars",
          "n_trades",
          "total_return",
          "sharpe",
          "max_drawdown",
          "win_rate",
          "expectancy",
          "final_equity",
          "equity_curve",
          "warnings"
        ],
        "title": "BacktestMetricsSchema",
        "type": "object"
      },
      "CandleSchema": {
        "properties": {
          "close": {
            "title": "Close",
            "type": "string"
          },
          "high": {
            "title": "High",
            "type": "string"
          },
          "low": {
            "title": "Low",
            "type": "string"
          },
          "open": {
            "title": "Open",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "volume": {
            "title": "Volume",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "timeframe",
          "ts",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "CandleSchema",
        "type": "object"
      },
      "EquityPoint": {
        "properties": {
          "equity": {
            "title": "Equity",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "ts",
          "equity"
        ],
        "title": "EquityPoint",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthSchema": {
        "properties": {
          "database": {
            "description": "Resultado de `SELECT 1`.",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "description": "`ok` solo si la base de datos responde y TimescaleDB está instalado.",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "timescaledb": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Versión de la extensión timescaledb, o `null` si no está instalada o la base de datos no responde.",
            "title": "Timescaledb"
          },
          "version": {
            "description": "Versión del backend.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "database",
          "timescaledb"
        ],
        "title": "HealthSchema",
        "type": "object"
      },
      "Timeframe": {
        "enum": [
          "5m",
          "15m",
          "1h",
          "4h",
          "1d"
        ],
        "title": "Timeframe",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "QuantAgentic Terminal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/market/ohlcv": {
      "get": {
        "operationId": "get_ohlcv_api_v1_market_ohlcv_get",
        "parameters": [
          {
            "description": "Símbolo canónico, p. ej. BTC/USDT",
            "in": "query",
            "name": "symbol",
            "required": true,
            "schema": {
              "description": "Símbolo canónico, p. ej. BTC/USDT",
              "minLength": 1,
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "description": "Timeframe de las velas",
            "in": "query",
            "name": "tf",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Timeframe",
              "description": "Timeframe de las velas"
            }
          },
          {
            "description": "Número de velas",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "description": "Número de velas",
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CandleSchema"
                  },
                  "title": "Response Get Ohlcv Api V1 Market Ohlcv Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Instrumento desconocido"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ohlcv",
        "tags": [
          "market"
        ]
      }
    },
    "/api/v1/quant/backtest": {
      "post": {
        "operationId": "post_backtest_api_v1_quant_backtest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestConfig-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestMetricsSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Instrumento desconocido"
          },
          "422": {
            "description": "Configuración inválida o datos insuficientes/excesivos"
          }
        },
        "summary": "Post Backtest",
        "tags": [
          "quant"
        ]
      }
    }
  }
}
